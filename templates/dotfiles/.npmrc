# ── Registry ──────────────────────────────────────────────────────────────────
registry=https://registry.npmjs.org/

# ── Security ──────────────────────────────────────────────────────────────────
audit-level=high

# ── Engine enforcement ────────────────────────────────────────────────────────
engine-strict=true

# ── Noise reduction ───────────────────────────────────────────────────────────
fund=false
update-notifier=false

# ── Corporate / Zscaler proxy ─────────────────────────────────────────────────
# Uncomment and fill in if behind a corporate proxy or Zscaler.
{{NPM_PROXY_LINES}}

# Zscaler intercepts TLS — point npm at the CA bundle if you see SELF_SIGNED errors.
{{NPM_CERT_LINE}}

# Last-resort TLS bypass (avoid — use cafile instead):
# strict-ssl=false
