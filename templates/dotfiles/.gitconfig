[user]
	name = {{GIT_NAME}}
	email = {{GIT_EMAIL}}

[core]
	autocrlf = false
	eol = lf
	editor = code --wait
	excludesfile = ~/.gitignore
	whitespace = fix,trailing-space,cr-at-eol

[credential]
	helper = {{GIT_CREDENTIAL_HELPER}}

[init]
	defaultBranch = main

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[pull]
	ff = only

[push]
	default = current

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[fetch]
	prune = true

[rerere]
	enabled = true

[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait $MERGED

[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[alias]
	st      = status -sb
	co      = checkout
	br      = branch -vv
	lg      = log --oneline --graph --decorate --all
	undo    = reset --soft HEAD~1
	unstage = reset HEAD --
	save    = stash push -m
	aliases = config --get-regexp alias

# ── Corporate proxy (uncomment / filled in by devsetup --dotfiles) ───────────
{{GIT_PROXY_BLOCK}}

# ── Zscaler self-signed cert (uncomment if TLS errors occur) ─────────────────
{{GIT_CERT_BLOCK}}
